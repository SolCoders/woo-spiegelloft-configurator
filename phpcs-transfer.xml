<?xml version="1.0"?>
<ruleset name="Mirror Layout Transfer">
	<description>WordPress standards for the new layout transfer subsystem.</description>
	<file>includes/transfer</file>
	<file>includes/admin/class-wcs-layout-transfer-admin.php</file>
	<file>templates/admin/layout-transfer.php</file>
	<file>templates/admin/layout-transfer-panel.php</file>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
